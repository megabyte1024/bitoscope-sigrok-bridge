foreach(variable DUMPBIN OBJECT REAL_DLL OUTPUT)
  if(NOT DEFINED ${variable})
    message(FATAL_ERROR "make_exports.cmake: -D${variable}=... is missing")
  endif()
endforeach()
get_filename_component(real_name "${REAL_DLL}" NAME)

execute_process(COMMAND "${DUMPBIN}" /nologo /symbols "${OBJECT}"
                RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE symbols_error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "make_exports.cmake: dumpbin /symbols ${OBJECT} failed: ${symbols_error}")
endif()
string(REGEX MATCHALL "SECT[0-9A-F]+ +notype \\(\\) +External +\\| +(libusb_|bridge_usb_)[A-Za-z0-9_]*" matches "${symbols}")
set(defined "")
foreach(match IN LISTS matches)
  string(REGEX REPLACE ".*\\| +" "" name "${match}")
  list(APPEND defined "${name}")
endforeach()
list(REMOVE_DUPLICATES defined)
list(SORT defined)

execute_process(COMMAND "${DUMPBIN}" /nologo /exports "${REAL_DLL}"
                RESULT_VARIABLE result OUTPUT_VARIABLE exports ERROR_VARIABLE exports_error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "make_exports.cmake: dumpbin /exports ${REAL_DLL} failed: ${exports_error}")
endif()
string(REGEX MATCHALL "\n +[0-9]+ +[0-9A-F]+ +[0-9A-F]+ +libusb_[A-Za-z0-9_]+" rows "${exports}")
set(real_functions "")
foreach(row IN LISTS rows)
  string(REGEX REPLACE ".* +(libusb_[A-Za-z0-9_]+)$" "\\1" name "${row}")
  list(APPEND real_functions "${name}")
endforeach()
list(REMOVE_DUPLICATES real_functions)
list(SORT real_functions)
list(LENGTH real_functions real_count)
if(real_count EQUAL 0)
  message(FATAL_ERROR "make_exports.cmake: no libusb function found in the export table of ${REAL_DLL}")
endif()

foreach(name IN LISTS defined)
  if(name MATCHES "^libusb_" AND NOT name IN_LIST real_functions)
    message(FATAL_ERROR "make_exports.cmake: bridge_usb.c defines ${name}, which ${real_name} does not export")
  endif()
endforeach()

set(text "LIBRARY \"bridge_usb.dll\"\nEXPORTS\n")
foreach(name IN LISTS defined)
  string(APPEND text "    ${name}\n")
endforeach()
foreach(name IN LISTS real_functions)
  if(NOT name IN_LIST defined)
    string(APPEND text "    ${name}\n")
  endif()
endforeach()
file(WRITE "${OUTPUT}" "${text}")
list(LENGTH defined defined_count)
message(STATUS "bridge_usb.def: ${defined_count} definitions of the shim's own, ${real_count} functions of ${real_name}")
